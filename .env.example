# Cloudflare tunnel/dev host for local HTTPS dev (Caddy); leave unset to use plain localhost.
CADDY_DEV_HOST=

# Public URL better-auth issues cookies/sessions against.
BETTER_AUTH_URL=http://localhost:3003

# CORS origin allowed to call the server worker.
CORS_ORIGIN=http://localhost:3002

# better-auth session/cookie signing secret (generate a random 32+ char string).
BETTER_AUTH_SECRET=

# Cloudflare AI Gateway auth token (account-created; used as the cf-aig-authorization
# bearer token for gateway requests).
AI_GATEWAY_TOKEN=

# BYOK provider-key registration (E3.2). Account-scoped API token authorizing Secrets Store
# writes (kept secret) and the Secrets Store id the keys are written into. The account id and
# gateway id are derived from the AI Gateway resource, not set here.
BYOK_CF_API_TOKEN=
BYOK_CF_STORE_ID=

# ── Prod stage (ADR 0039) ────────────────────────────────────────────────────
# The `prod` stage (ALCHEMY_STAGE=prod) deploys to think-space.app. Its prod-ONLY overrides
# live in a gitignored packages/infra/.env.prod, loaded with override:true only under that stage;
# everything below EXCEPT the fresh secret is inherited from this .env (shared across stages).
#
# packages/infra/.env.prod MUST define (names only — never commit values):
#   BETTER_AUTH_SECRET   # FRESH prod secret; MUST differ from the dev value above
# It MAY omit everything else. Origins are literals in alchemy.run.ts for prod, so
# BETTER_AUTH_URL / CORS_ORIGIN / INVITATION_ORIGIN are NOT read in the prod stage.
#
# Shared across stages (stay in this .env, inherited by prod):
#   AI_GATEWAY_TOKEN, BYOK_CF_STORE_ID, BYOK_CF_API_TOKEN, RESEND_API_KEY, INVITATION_FROM,
#   CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN
