{
  "name": "@thinkspace/domain",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./adapters": {
      "default": "./src/adapters/index.ts"
    },
    "./adapters/memory": {
      "default": "./src/adapters/memory/index.ts"
    },
    "./adapters/production": {
      "default": "./src/adapters/production/index.ts"
    },
    "./testing": {
      "default": "./src/testing/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-architecture": "bun ./scripts/check-import-boundaries.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test test/",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.93",
    "@cloudflare/think": "0.11.1",
    "agents": "0.17.1",
    "ai": "6.0.202",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "catalog:",
    "@thinkspace/config": "workspace:*",
    "@types/bun": "^1.3.0",
    "typescript": "catalog:",
    "vitest": "^4.1.9",
    "wrangler": "catalog:"
  }
}
